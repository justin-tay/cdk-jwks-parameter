{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "node"],
    // The example in bin/ imports the package by name, as a consumer would;
    // resolve it to the sources during development.
    "paths": {
      "cdk-jwks-parameter": ["./src/constructs"],
      "cdk-jwks-parameter/jwks": ["./src/shared/jwks"]
    }
  },
  "include": ["src", "test", "bin", "scripts"]
}
